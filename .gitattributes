*.webp filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text

# cachedBuilds/ is pipeline output (regenerated by npm run build:cached),
# not source art. GitHub Pages serves raw git blobs and doesn't run LFS
# smudge filters, so an LFS-tracked .webp there would be served as an
# unusable pointer file instead of the real image on the live site.
cachedBuilds/** -filter -diff -merge -text

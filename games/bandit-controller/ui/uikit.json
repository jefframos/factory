{
  "version": 1,
  "styles": {
    "primary": {
      "fontFamily": "Baloo2-ExtraBold",
      "fill": "#ffffff",
      "stroke": "#1d1b1a",
      "strokeWidth": 4,
      "letterSpacing": 2,
      "shadow": {
        "enabled": true,
        "color": "#000000",
        "alpha": 0.5,
        "angle": 90,
        "distance": 2,
        "blur": 0
      }
    },
    "secondary": {
      "fontFamily": "Baloo2-Regular",
      "fill": "#ffffff",
      "stroke": "#1d1b1a",
      "strokeWidth": 3,
      "letterSpacing": 0,
      "shadow": {
        "enabled": false,
        "color": "#000000",
        "alpha": 0.5,
        "angle": 90,
        "distance": 2,
        "blur": 0
      }
    }
  },
  "screens": {
    "levelComplete": {
      "label": "Level complete",
      "elements": {
        "panel": {
          "type": "image",
          "image": "BorderFrame_Round20_Single_Dark",
          "slice": [
            20,
            20,
            20,
            20
          ],
          "tint": "#ffffff"
        },
        "ribbon": {
          "type": "image",
          "image": "ResourceBar_Single_Btn_Green1",
          "slice": [
            20,
            20,
            20,
            20
          ],
          "tint": "#ffffff",
          "w": 190
        },
        "title": {
          "type": "text",
          "text": "LEVEL {level} COMPLETE",
          "fill": "#ffffff",
          "stroke": "#0b3d12",
          "strokeWidth": 5,
          "size": 20,
          "style": "primary"
        },
        "total": {
          "type": "text",
          "text": "${money} SECURED{bonus}",
          "fill": "#ffd15c",
          "stroke": "#3a2400",
          "strokeWidth": 5,
          "size": 24,
          "style": "primary"
        },
        "button": {
          "type": "image",
          "image": "Button01_s_Yellow",
          "slice": [
            30,
            40,
            30,
            40
          ],
          "tint": "#ffffff"
        },
        "buttonLabel": {
          "type": "text",
          "text": "{buttonText}",
          "fill": "#ffffff",
          "stroke": "#6b4200",
          "strokeWidth": 6,
          "size": 32,
          "style": "primary"
        }
      }
    },
    "busted": {
      "label": "Busted",
      "elements": {
        "panel": {
          "type": "image",
          "image": "BorderFrame_Round20_Single_Dark",
          "slice": [
            20,
            20,
            20,
            20
          ],
          "tint": "#ffffff"
        },
        "ribbon": {
          "type": "image",
          "image": "ResourceBar_Single_Btn_Red1",
          "slice": [
            20,
            20,
            20,
            20
          ],
          "tint": "#ffffff",
          "w": 300
        },
        "title": {
          "type": "text",
          "text": "BUSTED!",
          "fill": "#ffffff",
          "stroke": "#5a0d0d",
          "strokeWidth": 5,
          "size": 22,
          "style": "primary"
        },
        "message": {
          "type": "text",
          "text": "A guard caught you.\\nWatch their patrol and time it.",
          "fill": "#ffffff",
          "stroke": "#1d1d1d",
          "strokeWidth": 4,
          "size": 20,
          "style": "primary"
        },
        "button": {
          "type": "image",
          "image": "Button01_s_Yellow",
          "slice": [
            30,
            40,
            30,
            40
          ],
          "tint": "#ffffff"
        },
        "buttonLabel": {
          "type": "text",
          "text": "TRY AGAIN",
          "fill": "#ffffff",
          "stroke": "#6b4200",
          "strokeWidth": 6,
          "size": 32,
          "style": "primary"
        }
      }
    },
    "bonusMeter": {
      "label": "Bonus meter",
      "elements": {
        "panel": {
          "type": "image",
          "image": "BorderFrame_Round20_Single_Dark",
          "slice": [
            20,
            20,
            20,
            20
          ],
          "tint": "#ffffff"
        },
        "title": {
          "type": "text",
          "text": "BONUS!",
          "fill": "#ffffff",
          "stroke": "#0b3d12",
          "strokeWidth": 5,
          "size": 24,
          "style": "primary"
        },
        "button": {
          "type": "image",
          "image": "Button01_s_Green",
          "slice": [
            30,
            40,
            30,
            40
          ],
          "tint": "#ffffff"
        },
        "buttonLabel": {
          "type": "text",
          "text": "STOP",
          "fill": "#ffffff",
          "stroke": "#0b3d12",
          "strokeWidth": 6,
          "size": 40,
          "style": "primary"
        }
      }
    }
  }
}
